import cv2
import requests
import numpy as np
import time

CAMERA_IP = "192.168.1.91"
URL = f"http://{CAMERA_IP}/capture"

frames = 0
inicio = time.time()

print("Conectando con la ESP32-CAM...")
print("Presiona ESC para salir.")
print()

while True:

    try:
        response = requests.get(URL, timeout=5)

        if response.status_code == 200:

            datos = np.frombuffer(
                response.content,
                dtype=np.uint8
            )

            imagen = cv2.imdecode(
                datos,
                cv2.IMREAD_COLOR
            )

            if imagen is not None:

                frames += 1

                # Obtener resolución
                alto, ancho = imagen.shape[:2]

                # Mostrar resolución una sola vez
                if frames == 1:
                    print("--------------------------------")
                    print("CAMARA DETECTADA")
                    print(f"Resolucion: {ancho} x {alto}")
                    print("--------------------------------")

                # Calcular FPS
                ahora = time.time()
                transcurrido = ahora - inicio

                if transcurrido >= 1:
                    fps = frames / transcurrido

                    print(f"FPS: {fps:.2f}")

                    frames = 0
                    inicio = ahora

                # Mostrar imagen
                cv2.imshow(
                    "Sistema de Control de Calidad",
                    imagen
                )

        else:
            print(
                "Error HTTP:",
                response.status_code
            )

    except requests.exceptions.RequestException as e:
        print("Error de conexion:", e)

    # ESC para salir
    if cv2.waitKey(1) & 0xFF == 27:
        break

cv2.destroyAllWindows()