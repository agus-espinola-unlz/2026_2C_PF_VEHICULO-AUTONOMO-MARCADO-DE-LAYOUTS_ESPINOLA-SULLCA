import cv2
import requests
import numpy as np
import time

# ==========================================
# CONFIGURACIÓN
# ==========================================

CAMERA_IP = "192.168.1.91"
URL = f"http://{CAMERA_IP}/capture"

# ==========================================
# CAPTURA
# ==========================================

while True:

    try:
        respuesta = requests.get(URL, timeout=5)

        datos = np.frombuffer(
            respuesta.content,
            dtype=np.uint8
        )

        imagen = cv2.imdecode(
            datos,
            cv2.IMREAD_COLOR
        )

        if imagen is None:
            print("Error: no se pudo decodificar la imagen")
            continue

        # ==========================================
        # INFORMACIÓN DE LA IMAGEN
        # ==========================================

        alto, ancho = imagen.shape[:2]

        print(
            f"Resolución: {ancho} x {alto}",
            end="\r"
        )

        # ==========================================
        # CONVERSIÓN A ESCALA DE GRISES
        # ==========================================

        gris = cv2.cvtColor(
            imagen,
            cv2.COLOR_BGR2GRAY
        )

        # ==========================================
        # SUAVIZADO
        # ==========================================

        suavizada = cv2.GaussianBlur(
            gris,
            (5, 5),
            0
        )

        # ==========================================
        # UMBRAL
        # ==========================================

        _, mascara = cv2.threshold(
            suavizada,
            120,
            255,
            cv2.THRESH_BINARY
        )

        # ==========================================
        # MOSTRAR
        # ==========================================

        cv2.imshow(
            "Imagen original",
            imagen
        )

        cv2.imshow(
            "Escala de grises",
            gris
        )

        cv2.imshow(
            "Suavizada",
            suavizada
        )

        cv2.imshow(
            "Mascara",
            mascara
        )

        # ==========================================
        # TECLADO
        # ==========================================

        tecla = cv2.waitKey(1) & 0xFF

        if tecla == 27:  # ESC
            break

    except Exception as e:

        print(
            f"\nError: {e}"
        )

        time.sleep(1)

# ==========================================
# CERRAR
# ==========================================

cv2.destroyAllWindows()