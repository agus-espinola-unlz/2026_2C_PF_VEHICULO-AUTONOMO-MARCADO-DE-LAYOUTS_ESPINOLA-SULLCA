import cv2
import requests
import numpy as np
import math
import json


# ============================================================
# CONFIGURACIÓN
# ============================================================

CAMERA_IP = "192.168.1.91"
URL = f"http://{CAMERA_IP}/capture"

NOMBRE_CALIBRACION = "calibracion.json"


# ============================================================
# VARIABLES
# ============================================================

imagen_original = None
imagen_mostrar = None

puntos = []

mediciones = []


# ============================================================
# OBTENER IMAGEN
# ============================================================

def obtener_imagen():

    try:

        response = requests.get(
            URL,
            timeout=5
        )

        if response.status_code == 200:

            datos = np.frombuffer(
                response.content,
                dtype=np.uint8
            )

            imagen = cv2.imdecode(
                datos,
                cv2.IMREAD_COLOR
            )

            return imagen

        else:

            print(
                "Error HTTP:",
                response.status_code
            )

            return None

    except requests.exceptions.RequestException as e:

        print(
            "Error de conexión:",
            e
        )

        return None


# ============================================================
# CLICK DEL MOUSE
# ============================================================

def seleccionar_punto(
    event,
    x,
    y,
    flags,
    param
):

    global imagen_mostrar

    if event == cv2.EVENT_LBUTTONDOWN:

        # Solo permitimos dos puntos
        if len(puntos) >= 2:

            return

        puntos.append(
            (x, y)
        )

        print(
            f"Punto {len(puntos)}: "
            f"X={x}, Y={y}"
        )

        # Dibujar punto
        cv2.circle(
            imagen_mostrar,
            (x, y),
            5,
            (0, 0, 255),
            -1
        )

        # Si tenemos dos puntos
        if len(puntos) == 2:

            x1, y1 = puntos[0]
            x2, y2 = puntos[1]

            # Dibujar línea
            cv2.line(
                imagen_mostrar,
                (x1, y1),
                (x2, y2),
                (0, 255, 0),
                2
            )

        cv2.imshow(
            "Calibracion de Camara",
            imagen_mostrar
        )


# ============================================================
# CALCULAR DISTANCIA ENTRE DOS PUNTOS
# ============================================================

def distancia_pixeles(
    punto1,
    punto2
):

    x1, y1 = punto1
    x2, y2 = punto2

    distancia = math.sqrt(
        (x2 - x1) ** 2 +
        (y2 - y1) ** 2
    )

    return distancia


# ============================================================
# MOSTRAR MEDICIONES
# ============================================================

def mostrar_mediciones():

    print()
    print(
        "=========================================="
    )

    print(
        "          MEDICIONES REALIZADAS"
    )

    print(
        "=========================================="
    )

    for i, medicion in enumerate(
