            f"{medicion['distancia_pixeles']:.2f} px | "
            f"{medicion['pixeles_por_mm']:.4f} px/mm"
        )

    print(
        "=========================================="
    )


# ============================================================
# CALIBRACIÓN FINAL
# ============================================================

def calcular_calibracion():

    if len(mediciones) < 2:

        print()
        print(
            "Se necesitan al menos "
            "2 mediciones."
        )

        return

    # --------------------------------------------------------
    # Datos
    # --------------------------------------------------------

    mm = np.array(
        [
            m["distancia_real_mm"]
            for m in mediciones
        ],
        dtype=float
    )

    pixeles = np.array(
        [
            m["distancia_pixeles"]
            for m in mediciones
        ],
        dtype=float
    )

    # --------------------------------------------------------
    # Regresión lineal
    #
    # pixeles = a * mm + b
    # --------------------------------------------------------

    a, b = np.polyfit(
        mm,
        pixeles,
        1
    )

    # Valores predichos
    pixeles_pred = (
        a * mm + b
    )

    # --------------------------------------------------------
    # R²
    # --------------------------------------------------------

    ss_res = np.sum(
        (pixeles - pixeles_pred) ** 2
    )

    ss_tot = np.sum(
        (pixeles - np.mean(pixeles)) ** 2
    )

    if ss_tot != 0:

        r2 = 1 - (
            ss_res / ss_tot
        )

    else:

        r2 = 1.0

    # --------------------------------------------------------
    # Errores
    # --------------------------------------------------------

    errores_porcentuales = []

    for real, medido in zip(
        mm,
        pixeles
    ):

        # Predicción de píxeles
        esperado = (
            a * real + b
        )

        error = abs(
            medido - esperado
        )

        error_porcentual = (
            error / medido
        ) * 100

        errores_porcentuales.append(
            error_porcentual
        )

    error_promedio = np.mean(
        errores_porcentuales
    )

    # --------------------------------------------------------
    # Escalas
    # --------------------------------------------------------

    pixeles_por_mm = a

    mm_por_pixel = 1 / a

    # --------------------------------------------------------
    # Mostrar resultados
    # --------------------------------------------------------

    print()
    print()
    print(
        "=========================================="
    )

    print(
        "       CALIBRACIÓN MULTIPUNTO"
    )

    print(
        "=========================================="
    )

    print(
        f"Cantidad de mediciones : "
        f"{len(mediciones)}"
    )

    print()

    print(
        f"Coeficiente a          : "
        f"{a:.8f}"
    )

    print(
        f"Coeficiente b          : "
        f"{b:.8f}"
    )

    print()

    print(
        "Ecuación:"
    )

    print(
        f"px = {a:.6f} × mm + {b:.6f}"
    )

    print()

    print(
        f"Escala                 : "
        f"{pixeles_por_mm:.6f} px/mm"
    )

    print(
        f"Escala inversa         : "
        f"{mm_por_pixel:.6f} mm/px"
    )

    print()

    print(
        f"R²                     : "
        f"{r2:.8f}"
    )

    print(
        f"Error promedio         : "
        f"{error_promedio:.3f} %"
    )

    print(
        "=========================================="
    )

    # --------------------------------------------------------
    # Mostrar tabla
    # --------------------------------------------------------

    print()

    print(
        "Medición | Real (mm) | "
        "Píxeles | Esperado | Error"
    )

    print(
        "------------------------------------------"
    )

    for i in range(
        len(mediciones)
    ):

        real = mm[i]

        medido = pixeles[i]

        esperado = pixeles_pred[i]

        error = errores_porcentuales[i]

        print(
            f"{i + 1:^8} | "
            f"{real:^10.2f} | "
            f"{medido:^8.2f} | "
            f"{esperado:^8.2f} | "
            f"{error:^6.3f}%"
        )

    # --------------------------------------------------------
    # Guardar JSON
    # --------------------------------------------------------

    calibracion = {

        "camera_ip": CAMERA_IP,

        "resolucion": {

            "ancho":
                int(
                    imagen_original.shape[1]
                ),

            "alto":
                int(
                    imagen_original.shape[0]
                )
        },

        "tipo_calibracion":
            "multipunto",

        "cantidad_mediciones":
            len(mediciones),

        "coeficiente_a":
            float(a),

        "coeficiente_b":
            float(b),

        "pixeles_por_mm":
            float(pixeles_por_mm),

        "mm_por_pixel":
            float(mm_por_pixel),

        "r2":
            float(r2),

        "error_promedio_porcentual":
            float(error_promedio),

        "mediciones":
            mediciones
    }

    with open(
        NOMBRE_CALIBRACION,
        "w"
    ) as archivo:

        json.dump(
            calibracion,
            archivo,
            indent=4
        )

    print()

    print(
        f"Calibración guardada en: "
        f"{NOMBRE_CALIBRACION}"
    )


