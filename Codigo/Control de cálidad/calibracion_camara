print(
    "INSTRUCCIONES"
)

print(
    "------------------------------------------"
)

print(
    "1. Hacé click en dos puntos de la regla."
)

print(
    "2. Ingresá la distancia real en mm."
)

print(
    "3. Repetí con diferentes distancias."
)

print()

print(
    "Ejemplo:"
)

print(
    "20 mm, 40 mm, 60 mm, 80 mm..."
)

print()

print(
    "R = reiniciar puntos"
)

print(
    "F = finalizar calibración"
)

print(
    "ESC = salir"
)

print(
    "------------------------------------------"
)


# ============================================================
# LOOP PRINCIPAL
# ============================================================

while True:

    cv2.imshow(
        "Calibracion de Camara",
        imagen_mostrar
    )

    tecla = (
        cv2.waitKey(1) & 0xFF
    )

    # --------------------------------------------------------
    # ESC
    # --------------------------------------------------------

    if tecla == 27:

        break

    # --------------------------------------------------------
    # R = reiniciar puntos
    # --------------------------------------------------------

    elif tecla == ord("r"):

        puntos.clear()

        imagen_mostrar = (
            imagen_original.copy()
        )

        print()
        print(
            "Puntos reiniciados."
        )

    # --------------------------------------------------------
    # F = finalizar
    # --------------------------------------------------------

    elif tecla == ord("f"):

        calcular_calibracion()

        break

    # --------------------------------------------------------
    # DOS PUNTOS SELECCIONADOS
    # --------------------------------------------------------

    if len(puntos) == 2:

        # Calcular distancia
        distancia = distancia_pixeles(
            puntos[0],
            puntos[1]
        )

        print()

        print(
            "------------------------------------------"
        )

        print(
            f"Distancia en imagen: "
            f"{distancia:.3f} píxeles"
        )

        # Pedir distancia real
        while True:

            try:

                entrada = input(
                    "Distancia real en mm "
                    "(o ENTER para cancelar): "
                )

                if entrada == "":

                    puntos.clear()

                    imagen_mostrar = (
                        imagen_original.copy()
                    )

                    break

                distancia_real = float(
                    entrada
                )

                if distancia_real <= 0:

                    print(
                        "La distancia debe ser "
                        "mayor que 0."
                    )

                    continue

                # --------------------------------------------
                # Guardar medición
                # --------------------------------------------

                px_mm = (
                    distancia /
                    distancia_real
                )

                medicion = {

                    "punto_1": {

                        "x": puntos[0][0],
                        "y": puntos[0][1]
                    },

                    "punto_2": {

                        "x": puntos[1][0],
                        "y": puntos[1][1]
                    },

                    "distancia_pixeles":
                        float(distancia),

                    "distancia_real_mm":
                        float(distancia_real),

                    "pixeles_por_mm":
                        float(px_mm)
                }

                mediciones.append(
                    medicion
                )

                print()

                print(
                    f"Medición #{len(mediciones)} "
                    "guardada."
                )

                print(
                    f"{distancia_real:.2f} mm "
                    f"= {distancia:.2f} px"
                )

                # Mostrar mediciones
                mostrar_mediciones()

                print()

                print(
                    "Seleccioná otros dos "
                    "puntos para continuar."
                )

                # Reiniciar puntos
                puntos.clear()

                imagen_mostrar = (
                    imagen_original.copy()
                )

                break

            except ValueError:

                print(
                    "Ingresá un número válido."
                )