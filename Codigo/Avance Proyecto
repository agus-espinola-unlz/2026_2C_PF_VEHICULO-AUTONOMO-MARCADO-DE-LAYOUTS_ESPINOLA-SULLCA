    def iniciar_trayectoria(self):

        try:

            factor = float(self.entry_escala.get())

        except:

            self.cambiar_estado("ESCALA INVALIDA")

            return

        threading.Thread(target=self.ejecutar_puntos,args=(factor,),daemon=True).start() #Ejecuta "ejecutar_puntos" en un hilo aparte

    def ejecutar_puntos(self, factor):
        #Print("ENTRO A EJECUTAR_PUNTOS")
        #print("Coordenadas:", len(self.coordenadas))
        #self.actualizar_consola("ENTRO A EJECUTAR_PUNTOS")
        if len(self.coordenadas) == 0: #verifica que exista una trayectoria
            return
    
        # =====================================
        # GUARDAR PUNTO INICIAL
        # =====================================
    
        x_inicio = self.coordenadas[0][0] * factor #obtiene la primer posición
        y_inicio = self.coordenadas[0][1] * factor #obtiene la primer posición
        print("x_inicio =", x_inicio)
        print("y_inicio =", y_inicio)
        # =====================================
        # ENVIAR POSICION REAL DEL ROBOT
        # =====================================
        
        if ser and ser.is_open:
            print("ROBOT X =", self.robot_x)
            print("ROBOT Y =", self.robot_y)
            comando = (f"SETPOS:{self.robot_x:.2f},"f"{self.robot_y:.2f},"f"{self.robot_yaw:.2f}\n")
            ser.reset_input_buffer()
            ser.write(comando.encode()) #envia SETPOS
            #print("Enviado:", comando.strip())
            #self.actualizar_consola(f"TX: {comando.strip()}")
            self.actualizar_consola(f"Posicion inicial enviada: {comando.strip()}") #Muestra el mensaje en la interfaz
        
            while True: #Espera la confirmación
        
                if ser.in_waiting:
        
                    respuesta = ser.readline().decode(errors="ignore").strip()
                    print("Recibido:", respuesta)
                #    self.actualizar_consola(f"RX: {respuesta}")
                    if respuesta == "ACK":
                        break
        
                time.sleep(0.01)
        
        # =====================================
        # IR AL INICIO
        # =====================================
    
        comando = f"GOTO:{x_inicio:.2f},{y_inicio:.2f}\n"

        if ser and ser.is_open:
    
            ser.write(comando.encode()) #Envia comando GOTO
            ser.reset_input_buffer()
            self.actualizar_consola(f"Moviendo al inicio: {comando.strip()}")
    
            while True: #Espera al ACK para mandar otro GOTO
    
                if ser.in_waiting:
    
                    respuesta = ser.readline().decode(errors="ignore").strip()
    
                    if respuesta == "ACK":
                        break
    
                time.sleep(0.01)
    
        # =====================================
        # RECORRER CAD
        # =====================================
    
        for tray in self.coordenadas:
    
            x_mm = tray[2] * factor
            y_mm = tray[3] * factor
            pintar = tray[4] #NUEVO
            velocidad = tray[5] #NUEVO
            inspeccionar = tray[6] #NUEVO
            
            comando = f"GOTO:{x_mm:.2f},{y_mm:.2f}\n"
    
            if ser and ser.is_open:
              #  print("Antes del write")
                ser.reset_input_buffer()
                ser.write(comando.encode())
              #  print("Despues del write")
                self.actualizar_consola(f"Enviado: {comando.strip()}")
    
                while True:
    
                    if ser.in_waiting:
    
                        respuesta = ser.readline().decode(errors="ignore").strip()
    
                        if respuesta == "ACK":
                            break
    
                    time.sleep(0.01)
    
            self.resaltar_punto_actual(x_mm, y_mm)
    
        # =====================================
        # VOLVER AL INICIO
        # =====================================
    
        comando = f"GOTO:{x_inicio:.2f},{y_inicio:.2f}\n"
    
        if ser and ser.is_open:
            ser.reset_input_buffer()
            ser.write(comando.encode())
    
            self.actualizar_consola(f"Volviendo al inicio: {comando.strip()}")
    
            while True:
    
                if ser.in_waiting:
    
                    respuesta = ser.readline().decode(errors="ignore").strip()
    
                    if respuesta == "ACK":
                        break
    
                time.sleep(0.01)
    
        self.cambiar_estado("TRAYECTORIA FINALIZADA")

    # ==========================================
    # DXF
    # ==========================================

    def procesar_cad(self): #extrae el inicio y final de cada linea y polilinea

        archivo = filedialog.askopenfilename(title="Seleccionar DXF",filetypes=(("Archivos DXF","*.dxf"),))

        if not archivo:
            return

        self.ruta_cad = archivo
        self.coordenadas = [] #Aca se guardan las posiciones de cada linea y polilinea
        self.txt_log.delete("0.0","end")

        try:

            doc = ezdxf.readfile(archivo)
            msp = doc.modelspace()
            for entity in msp.query('LINE LWPOLYLINE'):

                if entity.dxftype() == 'LINE':

                    start = entity.dxf.start
                    end = entity.dxf.end
                    self.coordenadas.append([start.x,start.y,end.x,end.y,True,120,True]) #NUEVO

                elif entity.dxftype() == 'LWPOLYLINE':

                    puntos = list(entity.vertices())

                    for i in range(len(puntos)-1):

                        p1 = puntos[i]
                        p2 = puntos[i+1]

                        self.coordenadas.append([p1[0],p1[1],p2[0],p2[1]])
            #print("COORDENADAS EXTRAIDAS:", len(self.coordenadas))

            for c in self.coordenadas[:5]:
                print(c)
            self.actualizar_vista_previa()

        except Exception as e:

            print(e)
