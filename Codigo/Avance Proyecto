    def inspeccionar_linea(self, frame): #NUEVO
    
        x = 500
        y = 300
        ancho = 180
        alto = 180
    
        roi = frame[y:y+alto, x:x+ancho]
    
        cv2.rectangle(frame,(x, y),(x+ancho, y+alto),(0,255,0),2)
    
        gris = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)
    
        _, binaria = cv2.threshold(gris,60,255,cv2.THRESH_BINARY_INV)
    
        contornos, _ = cv2.findContours(binaria,cv2.RETR_EXTERNAL,cv2.CHAIN_APPROX_SIMPLE)
    
        cv2.imshow("ROI", roi)
        cv2.imshow("Binaria", binaria)
    
        if len(contornos) == 0:
            print("No hay tinta")
            return
    
        mayor = max(contornos, key=cv2.contourArea)
    
        area = cv2.contourArea(mayor)
    
        cv2.drawContours(roi,[mayor],-1,(0,255,0),2)
    
        print("Área:", area)
