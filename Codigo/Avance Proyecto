    def toggle_camera(self):

        if not self.camera_running:

            self.camera_running = True

            self.btn_camera.configure(text="Cerrar Cámara",fg_color="red")

            self.cap = cv2.VideoCapture(0, cv2.CAP_DSHOW)

            self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
            self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)

            threading.Thread(target=self.update_camera,daemon=True).start()

        else:

            self.camera_running = False

            self.btn_camera.configure(text="Abrir Cámara",fg_color="green")

            if self.cap:
                self.cap.release()

    # ==========================================
    # UPDATE CAMERA
    # ==========================================

    def update_camera(self):

        while self.camera_running:

            ret, frame = self.cap.read()
    
            if not ret:
                continue
    
            gray = cv2.cvtColor(frame,cv2.COLOR_BGR2GRAY)
    
            results = self.detector.detect(gray,estimate_tag_pose=True,camera_params=self.camera_params,tag_size=self.TAG_SIZE)
    
            home = next((r for r in results if r.tag_id == 0),None)
    
            tag1 = next((r for r in results if r.tag_id == 1),None)

            # =====================================
            # INSPECCIÓN CÁMARA
            # =====================================
            if self.inspeccion_activa:

                self.inspeccionar_linea(frame)
            # =====================================
            # TAG1 RESPECTO TAG0
            # =====================================
    
            if home and tag1: #pose_t es la posición del tag respecto a la cámara
    
                R0 = home.pose_R
                R1 = tag1.pose_R
                
                T0 = home.pose_t
                T1 = tag1.pose_t
                
                # ==================================
                # POSICION DE TAG1 EN SISTEMA TAG0
                # ==================================
                
                T_rel = R0.T @ (T1 - T0) #Calculo posición del robot respecto al tag0
                R_rel = R0.T @ R1 #Calculo rotación del robot respecto al tag0
                
                dx = float(T_rel[0,0]) #Posición del roboy respecto al tag0, es lo mismo que self.robot_x
                dy = -float(T_rel[1,0])
                dz = float(T_rel[2,0])
    
                # =================================
                # POSICIÓN DE TAGS
                # =================================
    
                self.robot_x = dx * 1000 # Es la distancia que mide la cámara entre TAGS
    
                self.robot_y = dy * 1000
        
                self.robot_yaw = np.degrees(np.arctan2(R_rel[1,0],R_rel[0,0])) #CALCULO ÁNGULO DE ORIENTACIÓN
    
                # =================================
                # TEXTO muestra la posición en el recuadro de la cámara
                # =================================
    
                cv2.putText(frame,f"X:{self.robot_x:.2f}mm",(30,200),cv2.FONT_HERSHEY_SIMPLEX,0.8,(0,255,255),2)
    
                cv2.putText(frame,f"Y:{self.robot_y:.2f}mm",(30,240),cv2.FONT_HERSHEY_SIMPLEX,0.8,(0,255,255),2)
    
                cv2.putText(frame,f"YAW:{self.robot_yaw:.1f}",(30,280),cv2.FONT_HERSHEY_SIMPLEX,0.8,(0,255,255),2)
    
                # =================================
                # DIBUJAR TAGS
                # =================================
    
                for tag,color in [(home,(255,0,0)),(tag1,(0,255,0))]:
    
                    corners = tag.corners.astype(int)
    
                    cv2.polylines(frame,[corners],True,color,2)
    
                    centro = tuple(tag.center.astype(int))
    
                    cv2.circle(frame,centro,5,(0,0,255),-1)
    
                    # =============================
                    # EJES XYZ
                    # =============================
    
                    axis_length = 0.1
    
                    opoints = np.float32([
                        [0,0,0],
                        [axis_length,0,0],
                        [0,axis_length,0],
                        [0,0,-axis_length]])
    
                    rvec,_ = cv2.Rodrigues(tag.pose_R)
    
                    tvec = tag.pose_t
    
                    imgpts,_ = cv2.projectPoints(opoints,rvec,tvec,self.camera_matrix,self.dist_coeffs)
    
                    imgpts = imgpts.astype(int)
    
                    origin = tuple(imgpts[0].ravel())
    
                    x_axis = tuple(imgpts[1].ravel())
    
                    y_axis = tuple(imgpts[2].ravel())
    
                    z_axis = tuple(imgpts[3].ravel())
    
                    # X rojo
                    cv2.line(frame,origin,x_axis,(0,0,255),3)
    
                    # Y verde
                    cv2.line(frame,origin,y_axis,(0,255,0),3)
    
                    # Z azul
                    cv2.line(frame,origin,z_axis,(255,0,0),3)
    
                # =================================
                # LABEL muestra posición en interfaz
                # =================================
    
                self.lbl_coords.configure(text=f"X:{self.robot_x:.2f}  Y:{self.robot_y:.2f}  YAW:{self.robot_yaw:.1f}")
    
                # =================================
                # GUARDAR PATH
                # =================================
    
                self.robot_path_x.append(self.robot_x) #guardo la posición
    
                self.robot_path_y.append(self.robot_y) #guardo la posición
    
                if len(self.robot_path_x) > 500: #funciona como ventana movil, va borrando posiciones viejas
    
                    self.robot_path_x.pop(0)
    
                    self.robot_path_y.pop(0)
    
                # =================================
                # ACTUALIZAR CAD
                # =================================
    
                self.ax.clear()
    
                # CAD ORIGINAL
                for tray in self.coordenadas:
    
                    x_values = [tray[0],tray[2]]
    
                    y_values = [tray[1],tray[3]]
    
                    self.ax.plot(x_values,y_values,color='cyan') #Dibuja el plano
    
                # PATH ROBOT. 
                self.ax.plot(self.robot_path_x,self.robot_path_y,color='red') #Dibuja la trayectoria
                   
                # Posición actual del robot
                self.ax.scatter(self.robot_x,self.robot_y,s=150,marker='o',color='blue') #Dibuja un punto en la pos actual
                
                # Etiqueta
                self.ax.text(self.robot_x,self.robot_y,"AGV",fontsize=10)
                
                self.ax.set_xlabel("X (m)")
                self.ax.set_ylabel("Y (m)")
                self.ax.grid(True)
                self.ax.set_aspect('equal')
                angulo = np.radians(self.robot_yaw)

                largo = 0.1
                
                self.ax.arrow(dx,dy,largo*np.cos(angulo),largo*np.sin(angulo),head_width=0.05)
                
                self.canvas.draw()
                
    
            # =====================================
            # FRAME TK
            # =====================================
    
            frame_rgb = cv2.cvtColor(frame,cv2.COLOR_BGR2RGB)
    
            img = Image.fromarray(frame_rgb)
    
            img = img.resize((800,600))
    
            imgtk = ImageTk.PhotoImage(image=img)
    
            self.video_label.imgtk = imgtk
    
            self.video_label.configure(image=imgtk)
    
            time.sleep(0.03)


